plan.txt
phasebyphase.txt

# ── Python runtime ────────────────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Pytest / test artefacts ───────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

