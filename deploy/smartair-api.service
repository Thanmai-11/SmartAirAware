[Unit]
Description=SmartAirAware API
After=network.target

[Service]
User=smartair
Group=smartair
WorkingDirectory=/opt/smartair
EnvironmentFile=/opt/smartair/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smartair/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
